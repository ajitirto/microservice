# API Gateway — public entry via HAProxy (fronts gateway instances)
GATEWAY_PORT=8080
GATEWAY_TIMEOUT=10s
GATEWAY_RATE_LIMIT=60
HAPROXY_STATS_PORT=8404

# Redis (caching user lookups, distributed rate limiting)
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Postgres — one database per service (database ownership principle)
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
AUTH_DATABASE_URL=postgres://postgres:postgres@postgres:5432/auth_db
USER_DATABASE_URL=postgres://postgres:postgres@postgres:5432/user_db
POST_DATABASE_URL=postgres://postgres:postgres@postgres:5432/post_db
NOTIFICATION_DATABASE_URL=postgres://postgres:postgres@postgres:5432/notification_db

# RabbitMQ (async event processing: post events -> notification)
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Internal service URLs (used by the gateway, resolved on the Docker network)
AUTH_SERVICE_URL=http://auth:8081
USER_SERVICE_URL=http://user:8082
POST_SERVICE_URL=http://post:8083
NOTIFICATION_SERVICE_URL=http://notification:8084

# Host ports for direct access to each service
AUTH_PORT=8081
USER_PORT=8082
POST_PORT=8083
NOTIFICATION_PORT=8084

# Metrics
PROMETHEUS_PORT=9095

# Auth service secrets (dev only)
AUTH_SECRET=dev-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=24h

# User service gRPC (internal contract used by post service)
USER_GRPC_PORT=9090
USER_GRPC_ADDR=user:9090

# Auth service gRPC (token verification used by the gateway)
AUTH_GRPC_PORT=9091
AUTH_GRPC_ADDR=auth:9091

# Logging
LOG_LEVEL=info